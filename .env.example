# Clusterio base images — THE SINGLE SOURCE for which images this cluster runs.
# Both service image tags (docker-compose.yml) and the CI host-image build-arg derive from
# this one value; bumping it IS the repin. It is REQUIRED: compose fails loudly rather than
# silently defaulting, because a silent default is how you end up running something other
# than what you pinned.
#
# PIN THE IMMUTABLE rN TAG. Upstream clusterio-docker publishes `:latest`, `:main`, and the
# bare `:<version>` as MOVING tags — a rebuild replaces them in place, so an unpinned pull can
# change the running image under you (their docs/consumer-integration.md says so, and the
# divergence is already real: bare :2.0.0-alpha.27 and :latest are sha256:4638552a…, while
# :2.0.0-alpha.27-r1 is sha256:e631d9e0…). Only the rN tag is immutable; upstream spells it
# `-rN` through r4 and `.rN` from r6 on.
CLUSTERIO_IMAGE_TAG=2.0.0-alpha.27.r7

# Controller
INIT_CLUSTERIO_ADMIN=
# CONTROLLER_HTTP_PORT=8080
# CONTROLLER_PUBLIC_ADDRESS=
# HOST_COUNT=0
DEFAULT_MOD_PACK=Space Age 2.0
# EXPORT_HOST=1  # Host ID with the Factorio game client — runs export-data during first-run seeding

# Host
# CONTROLLER_URL=http://clusterio-controller:8080/
# CLUSTERIO_HOST_TOKEN=
# SKIP_CLIENT=false

# Factorio Account — enables runtime game client download on host-1.
# The game client is needed for Clusterio's export-data flow (icon spritesheets).
# Downloaded once into the external `factorio-client-2117` volume, persists across restarts.
# Get your token from https://factorio.com/profile
# FACTORIO_USERNAME=
# FACTORIO_TOKEN=

# Factorio client variant for runtime download (default: expansion = Space Age DLC)
# Options: "expansion" (Space Age) or "alpha" (base game only)
# FACTORIO_CLIENT_BUILD=expansion
# FACTORIO_CLIENT_TAG=2.1.17
