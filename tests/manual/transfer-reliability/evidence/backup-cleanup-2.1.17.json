  "contract": {
    "schemaVersion": 3,
    "engine": "2.1.17",
    "invariants": [
      "At most one physically usable copy at each sampled boundary",
      "At least one copy retains the original per-item/quality, belt-side and fluid cargo",
      "Recovery does not send a second import for the canonical transfer ID",
      "Lost-reply and source-crash cases eventually complete with source absent and destination usable"
    ],
    "notInvariant": [
      "platform index after restore",
      "local simulation tick",
      "item position within a belt segment",
      "travel pause"
    ],
    "forbiddenAssists": [
      "manufactured successful reply",
      "editing cargo or validation evidence",
      "unlocking or deleting copies before observation",
      "changing recovery timers or receipt capacity"
    ],
