    "cases": [
      {
        "id": "coordinated-restore",
        "purpose": "Back up quiesced lab volumes with a completed transfer and an uncertain acknowledgement; erase, restore and require normal recovery plus exact cargo/history"
      },
      {
        "id": "lost-source-reply",
        "purpose": "Real source deletion succeeds; its host response is withheld, then controller disconnects and retries"
      },
      {
        "id": "lost-destination-reply",
        "purpose": "Real destination release succeeds; its host response is withheld, then controller disconnects and retries"
      },
      {
        "id": "aged-recovery-intent",
        "purpose": "Withhold a real source-deletion reply, stop the controller, age only the retained intent timestamp by one day, then restart and require completion"
      },
      {
        "id": "crash-source-before-save",
        "purpose": "SIGKILL source host after deletion but before a save containing its receipt; restart from the verified earlier checkpoint"
      },
      {
        "id": "restore-old-source",
        "purpose": "After acknowledged transfer completion, reload an earlier source save while retaining current controller/destination state"
      },
      {
        "id": "performance",
        "purpose": "Compare fixed small/large fixtures with operation timing disabled, normal timing, and batch timing; include scheduler and queue setup boundaries"
      }
    ]
  },
