{
	"compilerOptions": {
		"composite": true,
		"declaration": true,
		"declarationMap": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noImplicitOverride": true,
		"lib": ["es2023"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "es2022",
		"outDir": "dist/node",
		"rootDir": ".",
		"incremental": true,
		"sourceMap": true,
		"types": ["node"]
	},
	"include": [
		"index.ts",
		"messages.ts",
		"controller.ts",
		"instance.ts",
		"control.ts",
		"lib/**/*.ts",
		"shared/**/*.ts"
	],
	"exclude": ["dist/**", "node_modules/**"]
}
